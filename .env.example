SITE_URL=https://fluxo.today
ASTRO_BASE_PATH=./
SITE_NAME=Fluxo
CLARITY_PROJECT_ID=your_clarity_project_id
HERO_IMAGE_PATH=assets/hero.png
SITE_SCRIPT_PATH=script.js
TERMLY_WEBSITE_UUID=

LEADS_API_URL=https://api.example.com

# UUID of this Fluxo application in the MindAI backend. Used everywhere:
# lead capture on landing, sync-blog-content.ts (`--application-id`), and the
# GitHub workflow guard (`secrets.APPLICATION_ID`). Copy from
# apps/backends/MindAI-backend/src/common/constants/config.constant.ts
# (APPLICATIONS.FLUXO).
APPLICATION_ID=019e92d8-b331-7321-a2fc-a0f82fc0d2c3

GA_MEASUREMENT_ID=

TURNSTILE_SITE_KEY=

# ─── SEO content publishing ─────────────────────────────────────────────
# Consumed by scripts/sync-blog-content.ts and
# .github/workflows/publish-content.yml.

# MindAI backend base URL. Local dev: http://localhost:1224 — prod: the
# deployed backend URL. Protocol required, no trailing slash.
BACKEND_URL=http://localhost:1224

# Matches `X_API_KEY` on the MindAI backend. Authenticates the sync script
# against `GET :id/export`, `POST :id/complete`, `POST :id/fail`.
# Generate with `openssl rand -hex 32` on the backend, then copy here.
PUBLISHING_API_KEY=

# Optional — Orval reads the OpenAPI spec from MINDAI_SPEC_URL first, then
# falls back to ./openapi/mindai.json. Local default is the backend swagger
# endpoint; production/CI can point at a hosted spec.
MINDAI_SPEC_URL=http://localhost:1224/swagger.json
