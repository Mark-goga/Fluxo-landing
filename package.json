{
  "name": "fluxo-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-static-paths.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "sync:blog": "tsx scripts/sync-blog-content.ts",
    "test": "node --test scripts/sync-blog-content.test.mjs",
    "contracts:generate": "orval --config orval.config.ts",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- src/api/generated",
    "contracts:sync": "node scripts/pull-mindai-spec.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^6.4.2",
    "orval": "^7.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
