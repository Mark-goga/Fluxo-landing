---
import PageLayout from "@kit/layouts/PageLayout.astro";
import Header from "@kit/components/Header.astro";
import Footer from "@kit/components/Footer.astro";
import LeadModal from "@kit/components/LeadModal.astro";
import Breadcrumb, { type BreadcrumbItem } from "@kit/components/Breadcrumb.astro";
import { siteConfig } from "@kit/config/site";
import { landingContent, landingLanguageNav } from "@site/data/locales";

const ABOUT_PATH = "/about/";
const content = landingContent.en;

const breadcrumbItems: BreadcrumbItem[] = [
  { label: content.blog.ui.breadcrumbHome, href: "/" },
  { label: "About us" },
];

// Story-style gallery between "So we started building Fluxo." and the next paragraph.
const gallery = [
  { src: "/assets/photo_2026-10-08_17-48-43.jpg", alt: "Fluxo landing page open in Figma on a desk monitor, with a pug asleep on the keyboard" },
  { src: "/assets/photo_2026-10-08_17-49-06.jpg", alt: "Laptop with Fluxo app screens in progress on a garden table at sunset" },
  { src: "/assets/photo_2026-10-08_17-49-11.jpg", alt: "Fluxo onboarding and paywall screens laid out in Figma late at night" },
];

// Founder photos are portrait; the note frame is square, so the crop leans to the upper
// part of the photo where the faces are.
const founders = [
  { name: "Sofiya", role: "Co-founder & UX/UI Designer", initial: "S", photo: "/assets/Sofiya.jpg" },
  { name: "Markiian", role: "Co-founder & Developer", initial: "M", photo: "/assets/Mark.jpg" },
];
---

<PageLayout
  title={`About us — ${siteConfig.name}`}
  description="Learning shouldn't end when you close your notes. Meet Sofiya and Markiian, the designer and developer behind Fluxo."
  canonicalPath={ABOUT_PATH}
  routePath={ABOUT_PATH}
  lang="en"
>
  <Header content={content} routePath={ABOUT_PATH} languageNav={landingLanguageNav()} />

  <main class="about">
    <section class="about-hero">
      <div class="about-crumb fade" style="--d: 0s">
        <Breadcrumb items={breadcrumbItems} ariaLabel="About us" />
      </div>

      <div class="about-hero-inner">
        <h1 class="about-title fade" style="--d: 0.1s">Learning shouldn't end when you close your notes</h1>
        <p class="about-lead fade" style="--d: 0.35s">
          We spend hours learning new things. Reading articles, watching videos, taking courses, and saving everything
          that seems worth remembering. But somewhere along the way, most of that knowledge gets lost.
        </p>
      </div>

      <a class="about-scroll-cue fade" href="#our-story" style="--d: 0.9s" aria-label="Scroll to our story">
        <svg viewBox="0 0 24 24" width="42" height="42" fill="none" aria-hidden="true">
          <path class="about-scroll-cue-a" d="M6 6.5l6 5 6-5" />
          <path class="about-scroll-cue-b" d="M6 12.5l6 5 6-5" />
        </svg>
      </a>
    </section>

    <!-- Pinned story: text types in as you scroll -->
    <section class="about-story" id="our-story" data-story-pin>
      <div class="about-story-sticky">
        <div class="about-col">
          <h2 class="about-h2 reveal" data-reveal>Our story</h2>
          <div class="about-story-body">
            <p data-type><strong>Fluxo started with a simple problem we experienced ourselves.</strong></p>
            <p data-type>
              We're Sofiya and Markiian, a designer and a developer who had wanted to build something together for a
              long time.
            </p>
            <p data-type>
              It started when Markiian was looking for a better way to organize everything he was learning. Like many
              people, he had notes and useful materials scattered across different places.
            </p>
            <p data-type>
              But the more we talked about it, the more we realized that organization was only part of the problem.
            </p>
            <p data-type><strong>The real challenge was remembering what we'd learned.</strong></p>
            <p data-type>
              We didn't need another place to collect information. <strong>We needed a reason to come back to it.</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-col about-built">
      <div class="about-built-head">
        <p class="about-statement-main" data-type-scroll>So we started building Fluxo</p>
      </div>

      <div class="about-gallery reveal" data-reveal data-gallery style="--d: 0.15s">
        {
          gallery.map((photo, i) => (
            <img
              class:list={["about-gallery-img", { "is-active": i === 0 }]}
              src={photo.src}
              alt={photo.alt}
              width="960"
              height="1280"
              loading="lazy"
              decoding="async"
            />
          ))
        }
        <button class="about-gallery-zone about-gallery-zone--prev" type="button" data-gallery-prev aria-label="Previous photo"></button>
        <button class="about-gallery-zone about-gallery-zone--next" type="button" data-gallery-next aria-label="Next photo"></button>
        <div class="about-gallery-bars" aria-hidden="true">
          {gallery.map((_, i) => (
            <span class:list={["about-gallery-bar", { "is-active": i === 0 }]}><span></span></span>
          ))}
        </div>
      </div>
    </section>

    <section class="about-col about-text" data-type-scroll>
      <p>
        Our first ideas weren't perfect. Some changed completely after we spoke with other learners. And that became an
        important part of how we approach the product:{" "}
        <strong>understanding how people actually learn, rather than assuming we already know.</strong>
      </p>
      <p>We're still early in the journey, and there's a lot we want to improve.</p>
    </section>

    <section class="about-col about-text about-why">
      <h2 class="about-h2 reveal" data-reveal>Why we're building Fluxo</h2>
      <div data-type-scroll>
        <p>
          We believe learning should be more than collecting information you'll never revisit. It should be something you
          can return to naturally, practice in small steps, and gradually turn into knowledge that stays with you.
        </p>
        <p>
          That's why we're bringing notes, smart reminders, and interactive practice into one simple experience. Not to
          make people learn more. To help them remember more of what they already learn. And that's what we're building
          Fluxo for.
        </p>
      </div>
    </section>

    <!-- Founders: centred message, with two small sticky notes pinned on either side -->
    <section class="about-people">
      <div class="about-people-center">
        <img class="about-people-cat reveal" data-reveal src="/assets/about-cat.png" alt="" width="88" height="88" />
        <h2 class="about-people-quote reveal" data-reveal style="--d: 0.1s">Born from our needs and shaped by yours</h2>
        <p class="about-people-label reveal" data-reveal style="--d: 0.2s">The people behind Fluxo</p>
      </div>

      {
        founders.map((founder, i) => (
          <figure class={`about-note about-note--${i === 0 ? "left" : "right"} reveal`} data-reveal style={`--d: ${0.3 + i * 0.15}s`}>
            <span class="about-note-photo">
              {founder.photo ? (
                <img src={founder.photo} alt={`${founder.name}, ${founder.role}`} width="480" height="640" loading="lazy" decoding="async" />
              ) : (
                <span aria-hidden="true">{founder.initial}</span>
              )}
            </span>
            <figcaption>
              <span class="about-note-name">{founder.name}</span>
              <span class="about-note-role">{founder.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </section>
  </main>

  <Footer content={content} routePath={ABOUT_PATH} />
  <LeadModal content={content} />
</PageLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Fade-in-on-view for headings and blocks.
  const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("is-in"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-in");
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // Story-style gallery: each bar fills over a few seconds (CSS animation); when it ends we
  // advance. Tapping the left/right half steps back/forward; hovering pauses the fill.
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const imgs = Array.from(gallery.querySelectorAll<HTMLElement>(".about-gallery-img"));
    const bars = Array.from(gallery.querySelectorAll<HTMLElement>(".about-gallery-bar"));
    let index = 0;

    const show = (next: number) => {
      index = (next + imgs.length) % imgs.length;
      imgs.forEach((img, i) => img.classList.toggle("is-active", i === index));
      bars.forEach((bar, i) => {
        bar.classList.toggle("is-done", i < index);
        bar.classList.remove("is-active");
        if (i === index) {
          void bar.offsetWidth; // restart the fill animation
          bar.classList.add("is-active");
        }
      });
    };

    bars.forEach((bar) => bar.addEventListener("animationend", () => show(index + 1)));
    gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(index - 1));
    gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(index + 1));
  });

  // Scroll-driven typing: split text into per-character spans (words kept together so
  // lines never reflow), then reveal chars in proportion to scroll progress.
  const splitChars = (root: Element): HTMLElement[] => {
    const chars: HTMLElement[] = [];
    const splitNode = (node: Node) => {
      if (node.nodeType === Node.TEXT_NODE) {
        const frag = document.createDocumentFragment();
        (node.textContent ?? "").split(/(\s+)/).forEach((part) => {
          if (!part) return;
          if (/^\s+$/.test(part)) {
            frag.appendChild(document.createTextNode(" "));
            return;
          }
          const word = document.createElement("span");
          word.className = "ty-w";
          for (const ch of part) {
            const c = document.createElement("span");
            c.className = "ty-c";
            c.textContent = ch;
            word.appendChild(c);
            chars.push(c);
          }
          frag.appendChild(word);
        });
        node.parentNode?.replaceChild(frag, node);
      } else {
        Array.from(node.childNodes).forEach(splitNode);
      }
    };
    Array.from(root.childNodes).forEach(splitNode);
    return chars;
  };

  const showChars = (chars: HTMLElement[], target: number) => {
    for (let i = 0; i < chars.length; i++) chars[i].classList.toggle("on", i < target);
  };

  // Flowing blocks (not pinned): type as the block travels up the screen — starts when its
  // top enters the lower 10%, done when its bottom reaches 60% of the screen height.
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>("[data-type-scroll]").forEach((block) => {
      const chars = splitChars(block);
      block.classList.add("is-typing");
      let shown = -1;
      const update = () => {
        const rect = block.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh * 0.9 - rect.top) / (vh * 0.3 + rect.height)));
        const target = Math.round(progress * chars.length);
        if (target === shown) return;
        showChars(chars, target);
        shown = target;
      };
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }

  const pin = document.querySelector<HTMLElement>("[data-story-pin]");
  if (pin && !reduceMotion) {
    const chars: HTMLElement[] = [];
    pin.querySelectorAll("[data-type]").forEach((p) => chars.push(...splitChars(p)));
    pin.classList.add("is-typing");

    // If the story is taller than the screen (small phones), pinning would hide part of
    // it, so fall back to a normal flowing section with the full text shown.
    // Leave room for the fixed header above the pinned content.
    const sticky = pin.querySelector<HTMLElement>(".about-story-sticky");
    const content = pin.querySelector<HTMLElement>(".about-col");
    const fits = () => !content || content.offsetHeight <= window.innerHeight - 160;

    let shown = -1;
    const update = () => {
      const pinned = fits();
      pin.classList.toggle("no-pin", !pinned);
      if (!pinned) {
        if (shown !== chars.length) chars.forEach((c) => c.classList.add("on"));
        shown = chars.length;
        return;
      }
      const rect = pin.getBoundingClientRect();
      const stickyTop = sticky ? parseFloat(getComputedStyle(sticky).top) || 0 : 0;
      const travel = pin.offsetHeight - (sticky?.offsetHeight ?? 0);
      // Finish typing at 80% of the pinned distance so the full text rests on screen a moment.
      const progress = Math.min(1, Math.max(0, (stickyTop - rect.top) / (travel * 0.8)));
      const target = Math.round(progress * chars.length);
      if (target === shown) return;
      showChars(chars, target);
      shown = target;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
</script>

<style>
  /* Light palette matches the homepage; dark palette uses the site's dark theme tokens. */
  .about {
    --text: #0e0e0e;
    --text-secondary: rgba(14, 14, 14, 0.64);
    --text-tertiary: #6b6975;
    --card-bg: rgba(255, 255, 255, 0.5);
    --card-outline: #ffffff;
    --card-shadow: 0 4px 7.5px rgba(8, 3, 27, 0.08);

    color: var(--text-secondary);
    font-family: "Roboto Flex", system-ui, -apple-system, sans-serif;
  }

  /* Global `overflow-x: hidden` turns body into a scroll container, which breaks the
     sticky story pin. `clip` still blocks sideways scroll without that side effect. */
  :global(html),
  :global(body) {
    overflow-x: clip;
  }

  :global(html[data-theme="dark"]) .about {
    --text: #f5f2ff;
    --text-secondary: rgba(245, 242, 255, 0.64);
    --text-tertiary: #8b7da8;
    --card-bg: rgba(255, 255, 255, 0.04);
    --card-outline: rgba(255, 255, 255, 0.08);
    --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.35);
  }

  .about :global(.crumb) {
    --article-text-muted: var(--text-tertiary);
    --article-heading: var(--text);
  }

  /* Hero sits on the sky photo in both themes, so its text is always white. */
  .about-hero {
    --text: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.88);
    --text-tertiary: rgba(255, 255, 255, 0.78);
  }

  .about-hero :global(.crumb) {
    --article-border-strong: rgba(255, 255, 255, 0.6);
    --article-hover-bg: rgba(255, 255, 255, 0.16);
    --article-accent: #ffffff;
  }

  .about-title,
  .about-lead {
    text-shadow: 0 1px 18px rgba(38, 44, 120, 0.32);
  }

  /* ── Fade-in ─────────────────────────────── */
  .fade {
    opacity: 0;
    animation: about-fade-in 0.9s ease-out var(--d, 0s) forwards;
  }

  @keyframes about-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .reveal {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.7s ease var(--d, 0s),
      transform 0.7s ease var(--d, 0s);
  }

  .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ── Hero ────────────────────────────────── */
  .about-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    /* Fill the first screen under the header (main adds 80px), so "Our story" stays
       below the fold until you scroll and then fades in. */
    min-height: calc(100svh - 80px);
    box-sizing: border-box;
    /* Global `main` already offsets the fixed header by 80px; 56px more matches the blog. */
    padding: 56px 24px 64px;
    overflow: hidden;
  }

  /* Sky from the footer artwork. The layer is twice the hero's height (plus the strip under
     the header) and anchored to the top, so only the upper, deeper-blue sky shows. It stays
     fully opaque behind the text (white, like the homepage CTA) and fades out at both ends. */
  .about-hero::before {
    content: "";
    position: absolute;
    inset: -80px 0 auto;
    z-index: -1;
    height: calc(200% + 160px);
    background: url("/assets/footer-bg-light.jpg") center top / cover no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7%, #000 40%, transparent 50%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 7%, #000 40%, transparent 50%);
    pointer-events: none;
  }

  :global(html[data-theme="dark"]) .about-hero::before {
    background-image: url("/assets/footer-bg-dark.jpg");
  }

  /* Double chevron hinting to scroll: white at 16%, each chevron brightens in turn
     with a small downward nudge. */
  .about-scroll-cue {
    align-self: center;
    display: block;
    margin-top: 24px;
    color: #ffffff;
    line-height: 0;
  }

  .about-scroll-cue path {
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.16;
    animation: about-cue 1.8s ease-in-out infinite;
  }

  .about-scroll-cue .about-scroll-cue-b {
    animation-delay: 0.2s;
  }

  @keyframes about-cue {
    0%,
    100% {
      opacity: 0.16;
      translate: 0 0;
    }
    40% {
      opacity: 0.9;
      translate: 0 3px;
    }
  }

  .about-crumb {
    width: 100%;
    max-width: 1072px;
    margin: 0 auto;
  }

  .about-hero-inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 820px;
    margin: 0 auto;
    padding-top: 48px;
    text-align: center;
  }

  /* Matches the homepage H2 (.section-title): regular weight, 48px. */
  .about-title {
    margin: 0;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--text);
    text-wrap: balance;
  }

  .about-lead {
    max-width: 640px;
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* ── Shared column / headings ────────────── */
  .about-col {
    box-sizing: border-box;
    width: 100%;
    max-width: 672px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .about-h2 {
    margin: 0 0 24px;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--text);
  }

  .about strong {
    font-weight: 500;
    color: var(--text);
  }

  /* ── Pinned story ────────────────────────── */
  /* The pinned block is only as tall as its text and sticks just under the header, so
     nothing but the next section follows it once it releases (no empty half-screen). */
  .about-story {
    position: relative;
    height: 240vh;
    padding-top: 40px;
  }

  .about-story-sticky {
    position: sticky;
    top: 120px;
  }

  .about-story-body p {
    margin: 0 0 18px;
    font-size: 18px;
    line-height: 1.6;
  }

  .about-story.no-pin {
    height: auto;
  }

  .about-story.no-pin .about-story-sticky {
    position: static;
    padding-bottom: 40px;
  }

  .about :global(.ty-w) {
    white-space: nowrap;
  }

  .about .is-typing :global(.ty-c),
  .about-story.is-typing :global(.ty-c) {
    opacity: 0;
  }

  .about .is-typing :global(.ty-c.on),
  .about-story.is-typing :global(.ty-c.on) {
    opacity: 1;
  }

  /* ── "So we started building Fluxo." + gallery ─ */
  .about-built {
    padding-top: 0;
  }

  .about-built-head {
    padding: 120px 0 40px;
  }

  .about-statement-main {
    margin: 0;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text);
    text-wrap: balance;
  }

  /* Square frame, rounded like the homepage hero image */
  .about-gallery {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 32px;
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .about-gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .about-gallery-img.is-active {
    opacity: 1;
  }

  .about-gallery-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 50%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .about-gallery-zone--prev {
    left: 0;
    cursor: w-resize;
  }

  .about-gallery-zone--next {
    right: 0;
    cursor: e-resize;
  }

  .about-gallery-zone:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -6px;
    border-radius: 28px;
  }

  /* Story indicators along the bottom edge */
  .about-gallery-bars {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: flex;
    gap: 6px;
    pointer-events: none;
  }

  .about-gallery::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 96px;
    background: linear-gradient(to top, rgba(8, 3, 27, 0.35), transparent);
    pointer-events: none;
  }

  .about-gallery-bar {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
  }

  .about-gallery-bar > span {
    display: block;
    width: 100%;
    height: 100%;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .about-gallery-bar.is-done > span {
    transform: scaleX(1);
  }

  .about-gallery-bar.is-active > span {
    animation: about-story-fill 5s linear forwards;
  }

  .about-gallery:hover .about-gallery-bar.is-active > span {
    animation-play-state: paused;
  }

  @keyframes about-story-fill {
    to {
      transform: scaleX(1);
    }
  }

  .about-built + .about-text {
    padding-top: 48px;
  }


  /* ── Body text blocks ────────────────────── */
  .about-text p {
    margin: 0 0 24px;
    font-size: 18px;
    line-height: 1.6;
  }

  .about-why {
    padding-top: 120px;
    padding-bottom: 136px;
  }


  /* ── People ──────────────────────────────── */
  .about-people {
    position: relative;
    max-width: 1072px;
    min-height: 480px;
    margin: 0 auto;
    padding: 40px 24px 160px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .about-people-center {
    max-width: 520px;
    padding-top: 40px;
    text-align: center;
  }

  .about-people-cat {
    display: block;
    width: 88px;
    height: 88px;
    margin: 0 auto 24px;
    border-radius: 22px;
    box-shadow: 0 4px 7.5px rgba(8, 3, 27, 0.08);
  }

  .about-people-quote {
    margin: 0;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--text);
    text-wrap: balance;
  }

  .about-people-label {
