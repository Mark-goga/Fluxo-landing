---
import PageLayout from "@kit/layouts/PageLayout.astro";
import Header from "@kit/components/Header.astro";
import Footer from "@kit/components/Footer.astro";
import LeadModal from "@kit/components/LeadModal.astro";
import Breadcrumb, { type BreadcrumbItem } from "@kit/components/Breadcrumb.astro";
import { absoluteUrl, siteConfig, supportedLocales, type LocaleKey } from "@kit/config/site";
import { storeLinks, webAppLinks } from "@site/config/stores";
import { landingContent } from "@site/data/locales";
import { downloadContent, downloadLanguageNav, downloadPath, type DownloadPlatform } from "@site/data/download";

interface Props {
  locale: LocaleKey;
}

const { locale } = Astro.props;
const content = landingContent[locale];
const t = downloadContent[locale];
const DOWNLOAD_PATH = downloadPath(locale);

const breadcrumbItems: BreadcrumbItem[] = [
  { label: content.blog.ui.breadcrumbHome, href: content.path },
  { label: t.breadcrumb },
];

const alternates = [
  ...supportedLocales.map((opt) => ({ hreflang: opt.hreflang as string, href: absoluteUrl(downloadPath(opt.key)) })),
  { hreflang: "x-default", href: absoluteUrl(downloadPath("en")) },
];

// Store links pick up the visit's campaign from the kit attribution script by host; the
// web app link by its data-web-app-link marker.
const platforms: { key: DownloadPlatform; href: string; icon?: string }[] = [
  { key: "ios", href: storeLinks.appStore, icon: "/assets/ic_baseline-apple.svg" },
  { key: "android", href: storeLinks.googlePlay, icon: "/assets/material-icon-theme_google.svg" },
  { key: "web", href: webAppLinks.signUp },
];
---

<PageLayout
  title={`${t.metaTitle} — ${siteConfig.name}`}
  description={t.metaDescription}
  canonicalPath={DOWNLOAD_PATH}
  routePath={DOWNLOAD_PATH}
  lang={locale}
  alternates={alternates}
>
  <Header content={content} routePath={DOWNLOAD_PATH} languageNav={downloadLanguageNav()} />

  <main class="download">
    <div class="download-inner">
      <section class="download-hero">
        <Breadcrumb items={breadcrumbItems} ariaLabel={t.breadcrumb} />
        <h1 class="download-title" set:html={t.titleHtml} />
        <p class="download-lead">{t.lead}</p>
      </section>

      <ul class="download-grid" role="list">
        {
          platforms.map((platform) => (
            <li class="download-card" data-download-platform={platform.key}>
              <span class="download-device">{t.yourDevice}</span>
              <span class={`download-icon download-icon--${platform.key}`} aria-hidden="true">
                {platform.icon ? (
                  <img src={platform.icon} alt="" width="28" height="28" />
                ) : (
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3c2.5 2.7 3.75 5.7 3.75 9S14.5 18.3 12 21M12 3C9.5 5.7 8.25 8.7 8.25 12S9.5 18.3 12 21" />
                  </svg>
                )}
              </span>
              <h2 class="download-name">{t.platforms[platform.key].name}</h2>
              <p class="download-desc">{t.platforms[platform.key].desc}</p>
              <a
                class="download-cta"
                href={platform.href}
                data-web-app-link={platform.key === "web" ? "" : undefined}
                data-clarity-event={`download_${platform.key}_click`}
              >
                {t.platforms[platform.key].cta}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer content={content} routePath={DOWNLOAD_PATH} />
  <LeadModal content={content} routePath={DOWNLOAD_PATH} storeLinks={storeLinks} />
</PageLayout>

<script>
  // Point out the version for the device in hand: iPhone/iPad (older iPadOS) and Android
  // get their store, everything else the web app. Same detection as the kit's LeadModal.
  const ua = navigator.userAgent;
  const current = /iPad|iPhone|iPod/.test(ua) ? "ios" : /Android/.test(ua) ? "android" : "web";
  document.querySelector(`[data-download-platform="${current}"]`)?.classList.add("is-current");
</script>

<style>
  /* Light palette matches the homepage; dark palette uses the site's dark theme tokens. */
  .download {
    --text: #0e0e0e;
    --text-secondary: rgba(14, 14, 14, 0.64);
    --text-tertiary: #6b6975;
    --card-bg: rgba(255, 255, 255, 0.5);
    --card-outline: #ffffff;
    --card-shadow: 0 4px 7.5px rgba(8, 3, 27, 0.08);
    --cta-bg: #0a0716;
    --cta-bg-hover: #231b45;
    --accent: #4c27e3;
    --accent-hover: #3d1fb6;

    color: var(--text-secondary);
    font-family: "Roboto Flex", system-ui, -apple-system, sans-serif;
  }

  :global(html[data-theme="dark"]) .download {
    --text: #f5f2ff;
    --text-secondary: rgba(245, 242, 255, 0.64);
    --text-tertiary: #8b7da8;
    --card-bg: rgba(255, 255, 255, 0.04);
    --card-outline: rgba(255, 255, 255, 0.08);
    --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.35);
    --cta-bg: rgba(255, 255, 255, 0.08);
    --cta-bg-hover: rgba(255, 255, 255, 0.14);
    --accent: #6e4df0;
    --accent-hover: #886cf7;
  }

  .download :global(.crumb) {
    --article-text-muted: var(--text-tertiary);
    --article-heading: var(--text);
  }

  /* Global `main` already offsets the fixed header by 80px; 56px more matches About. */
  .download-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px 24px 112px;
  }

  .download-hero {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .download-title {
    margin: 32px 0 0;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--text);
    text-wrap: balance;
  }

  .download-lead {
    max-width: 560px;
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.6;
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .download-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border-radius: 24px;
    background: var(--card-bg);
    outline: 1px solid var(--card-outline);
    outline-offset: -1px;
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: outline-color 0.2s;
  }

  /* The one memorable move: the card for the device in hand is outlined in the brand
     purple, badged, and its button turns primary. */
  .download-card.is-current {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .download-device {
    position: absolute;
    top: 24px;
    right: 24px;
    display: none;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
  }

  .download-card.is-current .download-device {
    display: inline-block;
  }

  .download-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--cta-bg);
    color: #ffffff;
  }

  .download-name {
    margin: 24px 0 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
  }

  .download-desc {
    flex: 1;
    margin: 8px 0 28px;
    font-size: 16px;
    line-height: 1.5;
  }

  .download-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    border-radius: 12px;
    background: var(--cta-bg);
    color: #ffffff;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s;
  }

  .download-cta:hover {
    background: var(--cta-bg-hover);
  }

  .download-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .download-card.is-current .download-cta {
    background: var(--accent);
  }

  .download-card.is-current .download-cta:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 900px) {
    .download-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .download-inner {
      padding: 32px 20px 80px;
    }

    .download-hero {
      margin-bottom: 40px;
    }

    .download-title {
      font-size: 34px;
    }

    .download-lead {
      font-size: 16px;
    }

    .download-card {
      padding: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-card,
    .download-cta {
      transition: none;
    }
  }
</style>
